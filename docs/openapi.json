{
  "openapi": "3.0.3",
  "info": {
    "title": "Common Template API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": ""
    }
  ],
  "paths": {
    "/api/v1/posts": {
      "get": {
        "operationId": "getPosts",
        "summary": "게시글 목록 조회",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PostStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PostListResponse"
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPost",
        "summary": "게시글 생성",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts/{id}": {
      "get": {
        "operationId": "getPost",
        "summary": "게시글 상세 조회",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updatePost",
        "summary": "게시글 수정",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePost",
        "summary": "게시글 삭제",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "nullable": true,
                      "example": null
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me": {
      "get": {
        "operationId": "getMemberMe",
        "summary": "내 정보 조회",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/MemberMeResponse"
                    },
                    "error": {
                      "nullable": true,
                      "example": null
                    }
                  },
                  "required": ["success", "data", "error"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostStatus": {
        "type": "string",
        "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PostStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "title", "content", "author", "status", "createdAt", "updatedAt"]
      },
      "PostListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "totalCount": {
            "type": "integer"
          }
        },
        "required": ["items", "totalCount"]
      },
      "CreatePostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["title", "content"]
      },
      "UpdatePostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PostStatus"
          }
        }
      },
      "MemberMeResponse": {
        "type": "object",
        "properties": {
          "empNo": {
            "type": "string"
          },
          "empName": {
            "type": "string"
          },
          "deptName": {
            "type": "string"
          },
          "hasPosition": {
            "type": "boolean"
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "required": ["empNo", "empName", "deptName", "hasPosition", "isAdmin"]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["field", "message"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": ["code", "message"]
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "nullable": true,
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": ["success", "data", "error"]
      }
    }
  }
}
