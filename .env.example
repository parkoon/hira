VITE_APP_API_URL=
VITE_APP_ENABLE_API_MOCKING=true

# Supabase — 프로젝트 설정 > API 에서 확인한다
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_ANON_KEY=

# 시드 스크립트(pnpm supabase:seed)가 --env-file로 읽는다.
# 토큰 발급: https://supabase.com/dashboard/account/tokens
# Supabase MCP 서버(.mcp.json)는 .env를 읽지 못하므로 .claude/settings.local.json에 따로 넣는다.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
