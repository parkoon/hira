VITE_APP_API_URL=
VITE_APP_ENABLE_API_MOCKING=true

# Supabase — 프로젝트 설정 > API 에서 확인한다
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_ANON_KEY=

# 시드 스크립트(pnpm supabase:seed)와 Supabase MCP 서버(.mcp.json)가 공유한다.
# 이 파일이 아니라 셸/OS 환경변수로 넣어야 한다 — MCP는 .env를 읽지 않는다.
#   setx SUPABASE_PROJECT_REF "..."
#   setx SUPABASE_ACCESS_TOKEN "sbp_..."   # https://supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
